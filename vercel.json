{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/bot-tools/(.*)", "dest": "/404.html", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/bug", "dest": "/bug.html" },
    { "src": "/bug2", "dest": "/bug2.html" },
    { "src": "/changelog", "dest": "/changelog.html" },
    { "src": "/demo", "dest": "/demo.html" },
    { "src": "/marketing", "dest": "/marketing.html" },
    { "src": "/qa-fitur-baru", "dest": "/qa-fitur-baru.html" },
    { "src": "/sosialisasi-kepsek", "dest": "/sosialisasi-kepsek.html" },
    { "src": "/bot-suite", "dest": "/bot-suite.html" },
    { "src": "/sman6ska", "dest": "/sman6ska.html" },
    { "src": "/audit", "dest": "/audit_report_printable.html" },
    { "src": "/tws", "dest": "/tws.html" },
    { "src": "/tws/pdf-master", "dest": "/2_Daftar_Akun_Siswa_Per_Rombel_SMAN_1_Tawangsari.pdf" },
    { "src": "/tws/pdf-kelas-10", "dest": "/Daftar_Akun_Siswa_Kelas_X_SMAN_1_Tawangsari.pdf" },
    { "src": "/tws/pdf-kelas-11", "dest": "/Daftar_Akun_Siswa_Kelas_XI_SMAN_1_Tawangsari.pdf" },
    { "src": "/tws/pdf-kelas-12", "dest": "/Daftar_Akun_Siswa_Kelas_XII_SMAN_1_Tawangsari.pdf" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
