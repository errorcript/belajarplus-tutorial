{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/bot-tools/:match*", "destination": "/404.html" },
    { "source": "/audit", "destination": "/audit_report_printable.html" },
    { "source": "/panduan-asas", "destination": "/PANDUAN_ASAS_BELAJARPLUS/PANDUAN_LENGKAP_ASAS_STANDAR_DAN_TERKUNCI.pdf" },
    { "source": "/panduan-standar", "destination": "/PANDUAN_ASAS_BELAJARPLUS/PANDUAN_ASAS_MODE_STANDAR.pdf" },
    { "source": "/panduan-terkunci", "destination": "/PANDUAN_ASAS_BELAJARPLUS/PANDUAN_ASAS_MODE_TERKUNCI.pdf" }
  ]
}
