{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/bug", "destination": "/bug.html" },
    { "source": "/bug2", "destination": "/bug2.html" },
    { "source": "/changelog", "destination": "/changelog.html" },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/marketing", "destination": "/marketing.html" },
    { "source": "/qa-fitur-baru", "destination": "/qa-fitur-baru.html" },
    { "source": "/sosialisasi-kepsek", "destination": "/sosialisasi-kepsek.html" },
    { "source": "/bot-suite", "destination": "/bot-suite.html" },
    { "source": "/sman6ska", "destination": "/sman6ska.html" },
    { "source": "/audit", "destination": "/audit_report_printable.html" },
    { "source": "/tws", "destination": "/tws.html" }
  ]
}
