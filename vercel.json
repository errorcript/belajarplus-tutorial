{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/bot-tools/(.*)", "dest": "/404.html", "status": 404 },
    { "src": "/master.pdf", "dest": "/master.pdf" },
    { "src": "/kelas-10.pdf", "dest": "/kelas-10.pdf" },
    { "src": "/kelas-11.pdf", "dest": "/kelas-11.pdf" },
    { "src": "/kelas-12.pdf", "dest": "/kelas-12.pdf" },
    { "src": "/bug", "dest": "/bug.html" },
    { "src": "/bug2", "dest": "/bug2.html" },
    { "src": "/changelog", "dest": "/changelog.html" },
    { "src": "/demo", "dest": "/demo.html" },
    { "src": "/marketing", "dest": "/marketing.html" },
    { "src": "/qa-fitur-baru", "dest": "/qa-fitur-baru.html" },
    { "src": "/sosialisasi-kepsek", "dest": "/sosialisasi-kepsek.html" },
    { "src": "/bot-suite", "dest": "/bot-suite.html" },
    { "src": "/sman6ska", "dest": "/sman6ska.html" },
    { "src": "/audit", "dest": "/audit_report_printable.html" },
    { "src": "/tws", "dest": "/tws.html" },
    { "handle": "filesystem" },
    { "src": "/((?!.*\\.(?:pdf|png|jpg|jpeg|svg|css|js|ico|xlsx)).*)", "dest": "/404.html", "status": 404 }
  ]
}